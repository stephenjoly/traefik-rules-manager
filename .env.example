# Copy this file to `.env.local` for local development.
# Vite loads `.env.local` automatically for `npm run dev`.
# The backend can load the same file with `npm run server:dev`.

# Frontend
VITE_API_BASE=http://localhost:3001

# Backend
TRAEFIK_DYNAMIC_CONFIG_PATH=./testing/vm-critical/dynamic
TRM_METADATA_PATH=./testing/vm-critical/metadata
TRM_BACKUP_PATH=./testing/vm-critical/backups
TRM_PORT=3001
TRM_HOST=0.0.0.0
TRM_LOG_LEVEL=debug

# Optional auth for local testing
# Leave these blank to keep auth disabled locally.
TRM_ADMIN_USERNAME=
TRM_ADMIN_PASSWORD=
TRM_SESSION_SECRET=
TRM_AUTH_ENABLED=
TRM_SESSION_TTL_HOURS=12
TRM_COOKIE_SECURE=false

# Optional tuning
TRM_MAX_BACKUP_FILES=10
TRM_FILE_WATCH_DEBOUNCE=2000
